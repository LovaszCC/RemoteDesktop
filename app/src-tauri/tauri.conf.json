{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RemoteDesktop",
  "identifier": "hu.softworks.RemoteDesktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "RemoteDesktop",
        "width": 1000,
        "height": 640,
        "minWidth": 760,
        "minHeight": 460,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "category": "Utility",
    "shortDescription": "RDP, SSH, web and MikroTik connection manager",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libxdo3"
        ]
      },
      "rpm": {
        "depends": [
          "libxdo"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_TAURI_UPDATER_PUBLIC_KEY: run `pnpm -C app/ui tauri signer generate` and paste the .pub contents here. The updater stays inert until then.",
      "endpoints": [
        "https://github.com/LovaszCC/RemoteDesktop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
