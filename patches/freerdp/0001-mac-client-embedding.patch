 static DWORD WINAPI mac_client_thread(void *param);
+
+NSString *const MRDPViewDidDisconnectNotification = @"MRDPViewDidDisconnectNotification";
+
+/* Embedding hosts have no other way to learn that the session ended or never connected. */
+static void mac_post_view_disconnect(MRDPView *view, freerdp *instance)
+{
+	const UINT32 lastError = freerdp_get_last_error(instance->context);
+	const UINT32 errorInfo = freerdp_error_info(instance);
+	dispatch_async(dispatch_get_main_queue(), ^{
+		[[NSNotificationCenter defaultCenter]
+		    postNotificationName:MRDPViewDidDisconnectNotification
+		                  object:view
+		                userInfo:@{
+			                @"lastError" : @(lastError),
+			                @"errorInfo" : @(errorInfo)
+		                }];
+	});
+}
